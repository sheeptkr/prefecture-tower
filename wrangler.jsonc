{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prefecture-tower-battle",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-29",
  "durable_objects": {
    "bindings": [
      { "name": "BATTLE_ROOMS", "class_name": "BattleRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BattleRoom"] }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://sheeptkr.github.io,https://prefecture-tower-preview.pages.dev"
  }
}
