{
  "name": "prefecture-tower",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:generate": "tsx scripts/generate-prefectures.ts",
    "data:validate": "tsx scripts/validate-prefectures.ts",
    "check": "npm run lint && npm test && npm run data:validate && npm run build"
  },
  "dependencies": {
    "matter-js": "0.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@mapbox/vector-tile": "^2.0.4",
    "@playwright/test": "^1.54.2",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^24.3.0",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "mapshaper": "^0.6.113",
    "pbf": "^4.0.1",
    "poly-decomp": "^0.3.0",
    "proj4": "^2.19.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
